# Local persistence; takes priority over Supabase when set.
BOOK_CRAWLER_DB=data/searches.sqlite3
LOG_LEVEL=WARNING

# Optional: Aladin and foreign edition/ISBN resolution.
ALADIN_TTB_KEY=
GOOGLE_BOOKS_API_KEY=

# Optional remote persistence. Unset BOOK_CRAWLER_DB to use Supabase.
SUPABASE_URL=
SUPABASE_KEY=

# Optional AI descriptions; both keys are required.
BRAVE_SEARCH_API_KEY=
GEMINI_API_KEY=

# Production API: connect a private Vercel Blob store instead of SQLite/Supabase.
# BLOB_READ_WRITE_TOKEN=
# API_SERVICE_TOKEN=
# Production web (server-only):
# API_BACKEND_URL=https://book-crawling-api.vercel.app
# ACCESS_TOKEN=
